# ==============================================================================
# Sudoku Master Arena - Environment Configuration
# ==============================================================================

# Base URL path for deployment.
# Default is '/' for root domain deployment (e.g. https://my-sudoku-app.com/)
# Set to '/repository-name/' if deploying to GitHub Pages or subfolder (e.g. https://username.github.io/sudoku/)
VITE_BASE_URL=/

# ------------------------------------------------------------------------------
# 1v1 Battle relay (WebSocket)
# ------------------------------------------------------------------------------
# URL of the battle relay from server/index.js.
#
# Leave this unset for local development: the client falls back to
# ws://localhost:8787, which is what `npm run relay` starts.
#
# In production set it to your deployed relay, using wss:// if the app is served
# over https (browsers block insecure ws:// from an https page):
#
#   VITE_WS_URL=wss://your-relay.onrender.com
#
# Netlify and Vercel cannot host this server -- their functions are serverless
# and cannot hold an open connection. Deploy the relay to a Node host
# (Render/Railway/Fly/VPS; see render.yaml and Dockerfile) and point this at it.
#
# If you reverse-proxy the relay at /ws on the app's own domain, you can leave
# this unset in production too and the client will derive the URL.
#
# This is a build-time variable: change it and rebuild/redeploy.
# VITE_WS_URL=
